# Canonical public origin, including https:// (used by metadata and sitemap).
SITE_URL=http://localhost:3000

# Supabase project API URL, not its PostgreSQL connection string.
SUPABASE_URL=
# Read-only client. Published content uses RLS; keep this server-side in this app.
SUPABASE_PUBLISHABLE_KEY=
# Server-only privileged key. Never prefix it NEXT_PUBLIC_ or commit it.
SUPABASE_SECRET_KEY=

# Optional legacy key aliases (used only when the corresponding modern key is unset).
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional exact extra contact form origins, separated by commas.
# CONTACT_ALLOWED_ORIGINS=https://your-domain.com
# Optional dedicated secret for anonymized contact throttling keys.
# CONTACT_RATE_LIMIT_SECRET=
# Optional server-only token for a higher GitHub API rate limit.
# GITHUB_TOKEN=
